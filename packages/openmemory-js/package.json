{
    "name": "openmemory-js",
    "version": "1.3.3",
    "author": "nullure",
    "bin": {
        "opm": "./bin/opm.js",
        "openmemory-js": "./bin/opm.js"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "dev": "bun --watch src/server/index.ts",
        "format": "bun --bun prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "build": "bun build ./src/index.ts --outdir ./dist --target node && bun --bun tsc -p tsconfig.json",
        "start": "bun src/server/index.ts",
        "migrate": "bun src/core/migrate.ts",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "typecheck": "bun --bun tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@aws-sdk/client-bedrock-runtime": "^3.932.0",
        "@azure/msal-node": "^2.0.0",
        "@libsql/client": "^0.17.4",
        "@modelcontextprotocol/sdk": "^1.27.1",
        "@notionhq/client": "^2.2.0",
        "@octokit/rest": "^21.0.0",
        "cheerio": "^1.0.0",
        "dotenv": "^16.6.1",
        "fluent-ffmpeg": "^2.1.3",
        "googleapis": "^140.0.0",
        "ioredis": "^5.8.2",
        "mammoth": "^1.11.0",
        "openai": "^4.73.0",
        "pdf-parse": "^2.4.5",
        "turndown": "^7.2.2",
        "ws": "^8.18.3",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/cheerio": "^0.22.35",
        "@types/fluent-ffmpeg": "^2.1.26",
        "@types/node": "^20.19.25",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3"
    }
}